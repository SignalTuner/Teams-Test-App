{
  "$schema": "https://developer.microsoft.com/en-us/json-schemas/teams/v1.27/MicrosoftTeams.schema.json",
  "manifestVersion": "1.27",
  "version": "1.0.15",
  "id": "${{TEAMS_APP_ID}}",
  "developer": {
    "name": "My App, Inc.",
    "websiteUrl": "https://www.example.com",
    "privacyUrl": "${{TAB_ENDPOINT}}/tabs/privacy",
    "termsOfUseUrl": "${{TAB_ENDPOINT}}/tabs/terms"
  },
  "icons": {
    "color": "color.png",
    "outline": "outline.png"
  },
  "name": {
    "short": "SignalTuner${{APP_NAME_SUFFIX}}",
    "full": "SignalTuner for Microsoft Teams"
  },
  "description": {
    "short": "Join a SignalTuner meeting health view.",
    "full": "SignalTuner lets authenticated users in a Teams meeting join a shared meeting health view and share their own connectivity status."
  },
  "accentColor": "#FFFFFF",
  "supportsChannelFeatures": "tier1",
  "bots": [
  {
    "botId": "e32ebb3f-81e9-4ca2-85f1-a0a2d7b74999",
    "scopes": ["personal", "groupChat", "team"],
    "isNotificationOnly": false,
    "supportsFiles": false
  }
],
"webApplicationInfo": {
        "id": "e32ebb3f-81e9-4ca2-85f1-a0a2d7b74999",
        "resource": "${{TEAMS_SSO_RESOURCE}}"
}
,
  "composeExtensions": [],
  "staticTabs": [
    {
      "entityId": "home",
      "name": "SignalTuner",
      "contentUrl": "${{TAB_ENDPOINT}}/tabs/home",
      "websiteUrl": "${{TAB_ENDPOINT}}/tabs/home",
      "scopes": ["personal"],
      "context": ["personalTab"]
    }
  ],
  "configurableTabs": [
    {
      "configurationUrl": "${{TAB_ENDPOINT}}/tabs/config",
      "canUpdateConfiguration": true,
      "scopes": ["groupChat", "team"],
      "context": [
        "meetingChatTab",
        "meetingDetailsTab",
        "meetingSidePanel"
      ]
    }
  ],
  "meetingExtensionDefinition": {
    "scenes": [],
    "supportsStreaming": false
  },
  "permissions": ["identity"],
  "validDomains": [
    "${{TAB_DOMAIN}}",
    "teams.signaltuner.com",
    "www.signaltuner.com",
    "signaltuner-back.azurewebsites.net"
  ],
  "authorization": {
    "permissions": {
      "resourceSpecific": [
        {
          "name": "OnlineMeeting.ReadBasic.Chat",
          "type": "Delegated"
        },
        {
          "name": "OnlineMeeting.ReadBasic.Chat",
          "type": "Application"
        },
        {
          "name": "OnlineMeetingParticipant.Read.Chat",
          "type": "Application"
        }
      ]
    }
  }
      }
