# Manifest template only. Copy to .env.prod and supply the existing approved
# production Teams app ID; do not copy/replace a local app ID without confirmation.
# SSO URI below requires Entra verification; SSO stays paused in the frontend.
# DreamHost build does not consume this file. See docs/dreamhost-hosting.md.
TEAMSFX_ENV=prod
TEAMS_APP_ID=
TAB_DOMAIN=teams.signaltuner.com
TAB_ENDPOINT=https://teams.signaltuner.com
TEAMS_SSO_RESOURCE=api://teams.signaltuner.com/botid-e32ebb3f-81e9-4ca2-85f1-a0a2d7b74999
