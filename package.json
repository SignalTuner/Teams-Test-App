{
    "name": "signaltuner-teams-app",
    "version": "0.1.0",
    "private": true,
    "main": "dist/index",
    "types": "dist/index",
    "files": [
        "dist",
        "README.md"
    ],
    "dependencies": {
        "@microsoft/teams-js": "^2.0.0",
        "@microsoft/teams.api": "^2.0.0",
        "@microsoft/teams.apps": "^2.0.0",
        "@microsoft/teams.cards": "^2.0.0",
        "@microsoft/teams.client": "^2.0.0",
        "@microsoft/teams.common": "^2.0.0",
        "@microsoft/teams.dev": "^2.0.0",
        "@microsoft/teams.graph": "^2.0.0",
        "@microsoft/teams.graph-endpoints": "^2.0.0",
        "react": "^19.0.0",
        "react-dom": "^19.0.0"
    },
    "devDependencies": {
        "@types/node": "^22.5.4",
        "@types/react": "^19.1.12",
        "@types/react-dom": "^19.1.9",
        "@vitejs/plugin-react": "^4.3.4",
        "dotenv": "^16.4.5",
        "env-cmd": "^11.0.0",
        "nodemon": "^3.1.4",
        "rimraf": "^6.0.1",
        "tsup": "^8.4.0",
        "typescript": "^5.4.5",
        "vite": "^6.2.0"
    },
    "scripts": {
        "validate:store": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/validate-store-readiness.ps1",
        "dev:teamsfx": "env-cmd --silent -f .localConfigs npm run dev",
        "clean": "rimraf ./dist",
        "dev": "npm run build:frontend && nodemon",
        "build": "tsup && npm run build:frontend",
        "build:frontend": "vite build --outDir dist/client",
        "build:dreamhost": "node scripts/build-dreamhost.mjs",
        "validate:dreamhost": "node scripts/validate-dreamhost.mjs",
        "toolkit:production-disabled": "node scripts/production-toolkit-guard.cjs",
        "test:dreamhost": "node --test tests/dreamhost.test.mjs",
        "test:dreamhost-browser": "node --test tests/dreamhost.browser.cjs",
        "test:project-rename": "node --test tests/projectRename.test.cjs",
        "test:meeting-analysis": "node --test tests/meetingAnalysis.test.cjs",
        "test:analysis-live": "node --test tests/analysisLive.test.cjs",
        "test:service-status": "node --test tests/serviceStatus.test.cjs",
        "test:meeting-invitations": "node --test tests/meetingInvitations.test.cjs",
        "test:settings": "node --test tests/settingsAccount.test.cjs",
        "test:personal": "node --test tests/personalDashboard.test.cjs",
        "test:personal-browser": "node --test tests/personalDashboard.browser.cjs",
        "test:commerce": "node --test tests/teamsCommerce.test.cjs"
    }
}
